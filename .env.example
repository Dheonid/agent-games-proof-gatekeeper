# Copy to .env and fill in. NEVER commit .env. NEVER paste a private key
# or seed phrase here — only the platform-generated HMAC secret (and,
# optionally, a Kurier API key) belong in this file.

# Required. Dashboard -> your agent -> Rotate Secret, copy the one-time
# plaintext. A placeholder/mismatched secret makes preflight fail.
AGENT_GAMES_HMAC_SECRET=

# Optional. Without it, zkVerify submission is skipped and the local
# Groth16 proof + public_signals are still returned in the response.
KURIER_API_KEY=

# Optional overrides (defaults shown).
# KURIER_API_URL=https://api.kurier.xyz/api/v1
# GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
# PORT=8787
# CIRCUITS_DIR=./circuits
# SEEN_STORE_PATH=./data/seen.json
# KURIER_POLL_BUDGET_MS=15000
# TASK_SOFT_DEADLINE_MS=50000
